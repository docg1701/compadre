# Compadre — Environment Configuration
# Copy to .env and fill in values.

# Fernet key for encrypting tax IDs at rest in the key registry (REQUIRED).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_REGISTRY_ENCRYPTION_KEY=

# SQLite key registry path. Must match the in-container path used by both the
# compadre-stt container and the compadre-keys CLI (when run against the same
# mount). Compose bind-mounts the compadre-registry named volume at
# /var/lib/compadre, so the default below keeps the CLI and the service pointed
# at the same file.
KEY_REGISTRY_DB_PATH=/var/lib/compadre/registry.db

# Passphrase for AES-256-GCM encryption of the nightly backup tarball.
# Consumed by deploy/ansible/playbooks/backup-keys.yml + restore-keys.yml only;
# the FastAPI app and compadre-keys CLI never read it. Must be >= 16 chars when
# set; empty is accepted at boot so a fresh deployment can start before the
# bootstrap playbook runs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKUP_PASSPHRASE=

# IANA timezone for billing-day calculations and the daily suspension sweep's
# day-boundary. MUST match the cron CRON_TZ installed by bootstrap.yml — drift
# silently shifts the app's "today" relative to the cron schedule. Default UTC
# for operator-neutral predictability; override (e.g. America/Sao_Paulo) only
# when you've contractually informed customers that paid_until expires in that
# specific zone.
BILLING_TIMEZONE=UTC

# Operator contact string shown in CLI error hints (e.g. your ops email).
OPERATOR_CONTACT_HINT=

# Domain for HTTPS (Caddy auto-provisions Let's Encrypt cert).
# Use "localhost" for a self-signed cert on private networks.
DOMAIN=localhost

# Whisper model size (default: large-v3-turbo).
# Supported: tiny, base, small, medium, large-v1, large-v2, large-v3,
# large-v3-turbo. MVP uses large-v3-turbo only.
WHISPER_MODEL_SIZE=large-v3-turbo

# Whisper compute type (default: int8 for CPU-only deployments).
# Supported: int8, int8_float16, float16, float32.
WHISPER_COMPUTE_TYPE=int8

# CPU threads for Whisper inference (default: 4).
# Match to your VPS vCPU count for optimal throughput.
WHISPER_CPU_THREADS=4

# Default transcription language (default: pt for Portuguese).
# Set to empty or null for auto-detection.
WHISPER_LANGUAGE=pt

# HuggingFace cache directory inside the container.
# The compadre-models volume is mounted at /app/models.
HF_HOME=/app/models
